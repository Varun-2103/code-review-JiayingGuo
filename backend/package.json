{
  "name": "subletboard-backend",
  "version": "1.0.0",
  "description": "Express and MongoDB API for SubletBoard, sublets and roommates for Northeastern students.",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "npm run seed:users && npm run seed:sublets",
    "seed:users": "node scripts/seedUsers.js",
    "seed:sublets": "node scripts/seedSublets.js",
    "seed:demo": "node scripts/seedDemo.js"
  },
  "author": "Jiaying Guo, Yanli Wang",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "connect-mongo": "^6.0.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "mongodb": "^7.9.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
